{
  "name": "ua-crm",
  "private": true,
  "version": "0.0.0",
  "description": "Utopian Autonomy internal CRM",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=desktop --project=narrow --project=webkit-smoke tests/e2e",
    "test:a11y": "playwright test --project=desktop tests/a11y",
    "test:visual": "playwright test --project=desktop --project=narrow tests/visual",
    "test:visual:update": "tsx scripts/visual-update.ts",
    "test:perf": "playwright test --project=desktop tests/perf",
    "test:all": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm test:e2e && pnpm test:a11y && pnpm test:visual && pnpm test:perf && pnpm build",
    "tokens": "tsx scripts/generate-tokens.ts",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@paddleocr/paddleocr-js": "^0.4.2",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "chrono-node": "^2.10.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.7",
    "exceljs": "^4.4.0",
    "fastest-levenshtein": "^1.0.16",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.68.0",
    "motion": "^14.9.1",
    "pdfjs-dist": "^6.5.438",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.1.3",
    "lefthook": "^2.2.2",
    "pg": "^8.23.1",
    "supabase": "^3.0.0",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
