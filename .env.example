# Copy to .env.local and fill in. Nothing here is needed in Phase 0.

# Phase 1: Supabase (browser-safe values: the project URL and the publishable key only)
# VITE_DATA=supabase
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=

# The secret key and the database password never go in this file. They live only in GitHub
# secrets, for the release and backup workflows.

# Phase 2: Google Calendar OAuth (server-side token exchange)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Test hooks: enables /design and the perf sheet loader outside dev builds.
# VITE_ENABLE_TEST_HOOKS=1
