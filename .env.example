# Copy to .env.local and fill in. Nothing here is needed in Phase 0.

# Phase 1: Supabase (browser-safe values: the project URL and the publishable key only)
# VITE_DATA=supabase
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=

# The database password never goes in any file. The secret key lives in Vercel and GitHub
# secrets, and in your own .env.local only if you run the calendar locally.

# Phase 2: Google Calendar (the api/ functions; on Vercel these are project environment
# variables). Server-only: never prefix them with VITE_. `pnpm dev` serves /api with them.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# CALENDAR_TOKEN_KEY=            32 random bytes, base64 (docs/RUNBOOK.md)
# CALENDAR_TOKEN_KEY_VERSION=1
# CRON_SECRET=                   any long random string (Vercel sends it to the daily job)
# APP_BASE_URL=http://localhost:5173
# SUPABASE_URL=                  the same project URL as above
# SUPABASE_PUBLISHABLE_KEY=      the same publishable key as above
# SUPABASE_SECRET_KEY=           local development only, in .env.local; never committed

# Test hooks: enables /design and the perf sheet loader outside dev builds.
# VITE_ENABLE_TEST_HOOKS=1
