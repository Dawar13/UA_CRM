# Copy to .env.local and fill in. Nothing here is needed in Phase 0.

# Phase 1: Supabase (browser-safe values)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=

# Phase 1: server-side only (Vercel functions). Never expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY=

# Phase 2: Google Calendar OAuth (server-side token exchange)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Test hooks: enables /design and the perf sheet loader outside dev builds.
# VITE_ENABLE_TEST_HOOKS=1
